    "better-auth": "^1.7.7",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.453.0",
    "next": "^16.3.5",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
