{
  "name": "sai-digital-clone",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bunx prisma generate && bunx next dev -p 3000",
    "postinstall": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/postgres}\" bunx prisma generate",
    "build": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/postgres}\" bunx prisma generate && bunx next build",
    "start": "bunx next start -p 3000",
    "lint": "bunx eslint .",
    "test": "bun test tests/sections.test.tsx tests/all-services.test.tsx tests/speedx.test.tsx tests/smartcommerce.test.tsx tests/our-work.test.tsx tests/partners.test.tsx tests/blog-service.test.ts tests/auth-service.test.ts tests/upload-service.test.ts tests/people-validation.test.ts tests/category-service.test.ts",
    "test:e2e": "bunx playwright test",
    "prisma:generate": "bunx prisma generate",
    "prisma:push": "bunx prisma db push",
    "prisma:seed": "node scripts/seed.mjs",
    "prisma:migrate": "bunx prisma migrate dev",
    "seed:people": "bun scripts/seed-people.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.5",
    "@astryxdesign/theme-neutral": "^0.6.5",
    "@prisma/client": "^6.19.3",
