# Host port mapped to the Next.js container port 3000.
# Source cu dung 8080:80, source moi dung 8080:3000.
APP_PORT=8080

# MySQL container credentials.
MYSQL_DATABASE=egead
MYSQL_USER=egead
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Use the compose MySQL service by default.
DATABASE_URL=mysql://egead:change-this-mysql-password@db:3306/egead

# Production auth URLs must match the public domain served by Nginx/Traefik.
BETTER_AUTH_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=https://egeadcompany.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://egeadcompany.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
