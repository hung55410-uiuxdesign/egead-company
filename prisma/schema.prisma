// Prisma schema for E-GEAD Blog CMS & Better Auth
// Configured for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Better Auth Core Models
// -------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// -------------------------------------------------------------
// E-GEAD Blog & CMS Models
// -------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("category")
}

model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  subtitle     String?
  tag          String    @default("General")
  categoryName String    @default("E-Commerce")
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date         String
  readTime     String    @default("5 mins read")
  heroImage    String    @default("/assets/case_brother.jpg")
  excerpt      String
  content      String    // Rich text HTML from TipTap editor
  authorName   String    @default("E-GEAD Team")
  authorRole   String?   @default("Editor")
  authorAvatar String?
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status       String    @default("draft") // "draft" | "published" | "archived"
  views        Int       @default(0)
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@map("post")
}

// -------------------------------------------------------------
// E-GEAD People & Organization Models
// -------------------------------------------------------------

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  department  String   // 'Executive Leadership' | 'Technology & AI' | 'Commerce & Solutions' | 'Fulfillment & Operations' | 'Delivery & Growth'
  location    String   // 'Singapore / Global', 'Tokyo, Japan', 'Buon Ma Thuot, Vietnam', etc.
  quote       String?
  image       String   // URL ảnh Cloudinary / local asset
  linkedin    String?
  bio         String   @db.Text
  skills      String[] // Postgres native text array
  isLeader    Boolean  @default(false)
  order       Int      @default(0)
  status      String   @default("published") // 'published' | 'draft' | 'archived'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hierarchy   LeaderHierarchy?

  @@index([department])
  @@index([isLeader])
  @@index([status])
  @@map("team_member")
}

model LeaderHierarchy {
  id              String     @id @default(cuid())
  leaderId        String     @unique
  leader          TeamMember @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  departmentScope String
  overview        String     @db.Text
  childNodes      Json       // Lưu trữ mảng ChildNode[] (Squad Leads, squads, và sub-members)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("leader_hierarchy")
}

// -------------------------------------------------------------
// E-GEAD Contact & Inquiry Models
// -------------------------------------------------------------

model ContactInquiry {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  fullName  String
  company   String
  email     String
  phone     String?
  region    String
  message   String   @db.Text
  status    String   @default("new") // "new" | "contacted" | "resolved" | "archived"
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@map("contact_inquiry")
}

// -------------------------------------------------------------
// E-GEAD Case Studies / Our Work Models
// -------------------------------------------------------------

model CaseStudy {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  customer            String
  description         String   @db.Text
  image               String
  services            String[]
  industries          String[]
  tags                String[]
  highlight           String?
  order               Int      @default(0)
  status              String   @default("published") // 'published' | 'draft' | 'archived'

  // Detail Page Fields
  bannerImage         String?
  bannerVideo         String?

  // Section 1: Overview
  overviewSubtitle    String?  @default("OVERVIEW")
  overviewTitle       String?  @db.Text
  overviewDescription String?  @db.Text
  overviewImage       String?

  // Section 2: Challenge & Solution
  challengeTitle      String?  @db.Text
  challengeContent    String?  @db.Text
  solutionTitle       String?  @db.Text
  solutionContent     String?  @db.Text

  // Section 3: Task & Implementation
  taskSubtitle        String?  @default("TASK")
  taskTitle           String?  @db.Text
  taskImages          String[]
  taskItems           Json?    // Array of { taskTitle: string, description: string }

  // Section 4: Next Case Study
  nextStudySlug       String?
  nextStudyTitle      String?
  nextStudyCustomer   String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([order])
  @@map("case_study")
}

model ServiceItem {
  id                 String   @id @default(cuid())
  slug               String   @unique
  category           String   @default("service") // 'service' | 'industry'
  title              String
  tagline            String   @db.Text
  subtitle           String   @db.Text
  heroImage          String?
  middleImage        String?

  // Section 2: Overview
  overviewSubTitle   String?  @db.Text
  overviewHeading    String?  @db.Text
  overviewParagraphs String[]

  // Section 3: Approach & Principles
  approachHeading    String?  @default("Our approach")
  approachIntro      String?  @db.Text
  principles         Json?    // Array of { title: string, description: string }

  order              Int      @default(0)
  status             String   @default("published") // 'published' | 'draft'

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([order])
  @@map("service_item")
}

model HomeSection {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "marketplaces-partners"
  name        String   // Display name in admin
  title       String?  @db.Text
  subtitle    String?  @db.Text
  description String?  @db.Text
  data        Json?    // Flexible JSON content: { row1Partners: [...], row2Partners: [...] }
  isActive    Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([order])
  @@map("home_section")
}

// -------------------------------------------------------------
// E-GEAD Company Page Sections Models
// -------------------------------------------------------------

model CompanySection {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "company-hero", "company-intro", "company-4d-method", "company-value-system", "company-case-studies", "company-portals", "company-contact"
  name        String   // Display name in admin
  title       String?  @db.Text
  subtitle    String?  @db.Text
  description String?  @db.Text
  data        Json?    // Flexible JSON content per section
  isActive    Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([order])
  @@map("company_section")
}

// -------------------------------------------------------------
// E-GEAD Strategic Partner Models
// -------------------------------------------------------------

model PartnerItem {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  badge              String?
  headline           String?  @db.Text
  description        String?  @db.Text
  bannerImage        String?
  bannerFallback     String?
  ctaText            String?  @default("Schedule demo")
  ctaHref            String?  @default("/contact-us")

  // Section 2: Advantages
  advantagesSubtitle String?  @default("E-GEAD advantages")
  advantagesHeadline String?  @db.Text
  advantagesItems    Json?    // Array of { id, metric, description, iconName }

  // Section 3: Expertise
  expertiseSubtitle  String?  @default("Our expertise")
  expertiseHeadline  String?  @db.Text
  expertiseItems     Json?    // Array of { id, title, paragraphs: string[], image, imageFallback, alt }

  // Section 4: Why
  whyTitlePrefix     String?
  whyHeadline        String?  @db.Text
  whyDescription     String?  @db.Text
  whyItems           Json?    // Array of { id, title, content }

  // Section 5: Case studies
  casesSubtitle      String?  @default("Proven outcomes")
  casesHeadline      String?  @default("Read our cases")
  casesItems         Json?    // Array of { id, slug, customer, title, tags: string[], image }

  // Section 6: CTA
  ctaHeadingPart1    String?  @default("Unleash your ")
  ctaHighlight       String?  @default("growth potential")
  ctaHeadingPart2    String?
  ctaDescription     String?  @db.Text
  ctaButtonText      String?  @default("Let's talk")
  ctaButtonHref      String?  @default("/contact-us")

  // SEO
  metaTitle          String?
  metaDescription    String?  @db.Text

  order              Int      @default(0)
  status             String   @default("published") // 'published' | 'draft'

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([order])
  @@map("partner_item")
}



// -------------------------------------------------------------
// E-GEAD Career & Recruitment Models
// -------------------------------------------------------------

model CareerJob {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  department        String   @default("General")
  location          String   @default("Hanoi")
  type              String   @default("Full-time")
  experience        String   @default("Not required")
  salary            String   @default("Negotiable")
  quantity          String   @default("01")
  deadline          String   @default("2026-12-31")
  excerpt           String   @default("") @db.Text
  description       String   @default("") @db.Text
  requirements      String   @default("") @db.Text
  benefits          String   @default("") @db.Text
  content           String?  @default("") @db.Text
  contactEmail      String   @default("hr@egead.com")
  status            String   @default("published") // 'published' | 'draft' | 'closed'
  featured          Boolean  @default(false)
  views             Int      @default(0)
  applicationsCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([department])
  @@map("career_job")
}

model CareerApplication {
  id              String   @id @default(cuid())
  jobId           String   @default("general")
  jobTitle        String   @default("General Application")
  fullName        String
  email           String
  phone           String
  cvUrl           String   @db.Text
  portfolioUrl    String?
  expectedSalary  String?
  experienceYears String?
  startDate       String?
  coverLetter     String?  @db.Text
  status          String   @default("pending") // 'pending' | 'reviewing' | 'interview' | 'offered' | 'rejected'
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([email])
  @@map("career_application")
}
